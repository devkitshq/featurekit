{
  "name": "featurekit-mcp",
  "version": "0.1.0",
  "description": "featurekit MCP server: manage feature flags from Claude and other MCP clients, through the admin API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "featurekit-mcp": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "keywords": [
    "feature-flags",
    "featurekit",
    "mcp",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devkitshq/featurekit.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
